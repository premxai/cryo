# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic Claude API (used in M4 RLAIF judge)
ANTHROPIC_API_KEY=

# GPTZero AI detection API (used in M2 authenticity scoring)
GPTZERO_API_KEY=

# ── Search Infrastructure ──────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=cryo_dev_key

QDRANT_URL=http://localhost:6333

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:cryo@localhost:5432/cryo
REDIS_URL=redis://localhost:6379

# ── App Config ─────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO

# Embedding model name (sentence-transformers, used from M3)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_TTL_SECONDS=86400

# Claude model for AI judge (used from M4)
JUDGE_MODEL=claude-3-5-haiku-20241022

# ── SaaS API (/v1) ─────────────────────────────────────────────────────────────
# Free-tier limits applied to new keys
FREE_TIER_MONTHLY_QUOTA=1000
FREE_TIER_RATE_PER_MINUTE=60

# /v1/contents Wayback live fetch
WAYBACK_TIMEOUT_SECONDS=25
CONTENTS_MAX_ITEMS=10
CONTENTS_NEGATIVE_CACHE_TTL=3600

# Dashboard signup (magic links) — Resend API key; empty = links logged (dev)
RESEND_API_KEY=
# Public URL of the frontend, used in emailed sign-in links
PUBLIC_BASE_URL=http://localhost:5173
# HMAC secret for dashboard session tokens — set a strong random value in prod
SESSION_SECRET=dev_session_secret_change_me
SESSION_TTL_HOURS=72
MAGIC_LINK_TTL_MINUTES=15

# Clerk authentication (dashboard API-key management)
# Set VITE_CLERK_PUBLISHABLE_KEY in the frontend/Vercel environment.
CLERK_ISSUER=
CLERK_JWKS_URL=

# CORS override (comma-separated origins); empty = env defaults
ALLOWED_ORIGINS=
